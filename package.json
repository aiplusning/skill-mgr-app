import { NextResponse } from 'next/server'
import { sqlite } from '@/lib/db'

export const dynamic = 'force-dynamic'

function buildSkillQuery(search: string | null, category: string | null, tag: string | null, project: string | null, tool: string | null) {
  const clauses: string[] = []
  const params: string[] = []

  if (search && search.trim()) {
    const term = search.trim()
    clauses.push('s.id IN (SELECT rowid FROM skills_fts WHERE skills_fts MATCH ? )')
    params.push(term)
  }

  if (category) {
    clauses.push('s.category = ?')
    params.push(category)
  }

  if (tag) {
    clauses.push(`EXISTS (SELECT 1 FROM skill_tags st JOIN tags t ON t.id = st.tag_id WHERE st.skill_id = s.id AND t.name = ?)`)
    params.push(tag)
  }

  if (project) {
    clauses.push(`EXISTS (SELECT 1 FROM skill_projects sp JOIN projects p ON p.id = sp.project_id WHERE sp.skill_id = s.id AND p.name = ?)`)
    params.push(project)
  }

  if (tool) {
    clauses.push(`EXISTS (SELECT 1 FROM skill_tools st JOIN tools t ON t.id = st.tool_id WHERE st.skill_id = s.id AND t.name = ?)`)
    params.push(tool)
  }

  const base = `SELECT DISTINCT s.id, s.slug, s.name, s.description, s.status, s.category, s.updated_at
    FROM skills s`

  const query = `${base}${clauses.length ? ` WHERE ${clauses.join(' AND ')}` : ''} ORDER BY s.updated_at DESC, s.name ASC`
  return { query, params }
}

export async function GET(request: Request) {
  const url = new URL(request.url)
  const q = url.searchParams.get('q')
  const category = url.searchParams.get('category')
  const tag = url.searchParams.get('tag')
  const project = url.searchParams.get('project')
  const tool = url.searchParams.get('tool')

  const { query, params } = buildSkillQuery(q, category, tag, project, tool)
  const rows = sqlite.prepare(query).all(...params) as Array<{
    id: string
    slug: string
    name: string
    description: string | null
    status: string | null
    category: string | null
    updated_at: number
  }>

  return NextResponse.json({
    ok: true,
    data: rows.map((row) => ({ ...row, updated_at: Number(row.updated_at || 0) })),
  })
}
